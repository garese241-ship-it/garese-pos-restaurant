<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Floor: background picture of the plan, state of the tables -->
    <record id="gp_view_restaurant_floor_form" model="ir.ui.view">
        <field name="name">restaurant.floor.form.garese.pos</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_ids']" position="before">
                <group string="Floor Plan Picture" name="gp_background">
                    <field name="background_image" widget="image" nolabel="1" colspan="2"
                           options="{'size': [0, 180]}"/>
                    <div class="text-muted" colspan="2">Picture of the room (walls, bar, terrace...) shown behind the tables in the Point of Sale, at its real size: 1 pixel of the picture is 1 pixel of the plan. Place the tables on it with "Edit Plan" in the Point of Sale.</div>
                </group>
            </xpath>
            <xpath expr="//field[@name='table_ids']/tree/field[@name='shape']" position="after">
                <field name="gp_waiter_id" optional="show" options="{'no_create': True}"/>
                <field name="gp_unavailable" widget="boolean_toggle"/>
                <field name="gp_reserved_name" optional="show"/>
                <field name="gp_reserved_at" optional="show"/>
                <field name="gp_reserved_guests" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="gp_view_restaurant_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form.garese.pos</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='seats']" position="after">
                <field name="gp_waiter_id" options="{'no_create': True}"/>
                <field name="gp_unavailable"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Reservation" name="gp_reservation" col="2">
                    <field name="gp_reserved_name"/>
                    <field name="gp_reserved_at"/>
                    <field name="gp_reserved_guests"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Settings of the Point of Sale -->
    <record id="gp_res_config_settings_view_form_restaurant" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.garese.pos.restaurant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="garese_pos.gp_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='gp_garese_pos_section']" position="inside">
                <setting string="Table Reservations" invisible="not pos_module_pos_restaurant"
                         help="When a reserved table turns blue on the floor plan, and when it is released if the guests do not come.">
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="pos_gp_reservation_before" string="Hold (min before)" class="col-lg-5 o_light_label"/>
                            <field name="pos_gp_reservation_before" class="col-lg-3"/>
                        </div>
                        <div class="row">
                            <label for="pos_gp_reservation_after" string="Release (min after)" class="col-lg-5 o_light_label"/>
                            <field name="pos_gp_reservation_after" class="col-lg-3"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
