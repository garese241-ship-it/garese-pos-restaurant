<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="garese_pos_restaurant.Table" t-inherit="pos_restaurant.Table" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('table')]" position="attributes">
            <attribute name="t-att-class">gpClass</attribute>
            <attribute name="t-att-title">gpOn ? gpTitle : undefined</attribute>
        </xpath>
        <!-- The standard content is kept for the plan editor and small screens -->
        <xpath expr="//div[hasclass('infos')]" position="attributes">
            <attribute name="t-if">!gpOn</attribute>
        </xpath>
        <xpath expr="//span[hasclass('table-seats')]" position="attributes">
            <attribute name="t-if">!gpOn</attribute>
        </xpath>
        <xpath expr="//div[hasclass('table')]" position="inside">
            <t t-if="gpOn">
                <i t-if="gpIcon" class="gp-tb-icon fa" t-att-class="gpIcon"/>
                <span t-if="gpInfo.orders > 1" class="gp-tb-count" t-esc="gpInfo.orders"/>
                <span t-if="gpInfo.waiterName" class="gp-tb-waiter" t-esc="gpWaiterShort"/>
                <span class="gp-tb-name" t-esc="props.table.name"/>
                <t t-set="sub" t-value="gpSub"/>
                <span t-if="sub.seats" class="gp-tb-seats"><i class="fa fa-user"/><t t-esc="sub.seats"/></span>
                <span t-else="" class="gp-tb-state" t-esc="sub.text"/>
                <span t-if="gpMeta" class="gp-tb-meta" t-esc="gpMeta"/>
            </t>
        </xpath>
    </t>

</templates>
