<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="garese_pos_restaurant.GpReservationPopup">
        <div class="popup gp-resa-popup">
            <div class="modal-header">
                <h4 class="modal-title"><t t-esc="props.title"/></h4>
            </div>
            <div class="modal-body">
                <label class="gp-resa-field">
                    <span class="gp-resa-label">Name of the reservation</span>
                    <input class="form-control form-control-lg" type="text" t-model="state.name" t-ref="name"
                           placeholder="Customer name, phone..."/>
                </label>
                <div class="gp-resa-row">
                    <label class="gp-resa-field">
                        <span class="gp-resa-label">Date</span>
                        <input class="form-control form-control-lg" type="date" t-model="state.date"/>
                    </label>
                    <label class="gp-resa-field">
                        <span class="gp-resa-label">Arrival time</span>
                        <input class="form-control form-control-lg" type="time" t-model="state.time"/>
                    </label>
                </div>
                <div class="gp-resa-field">
                    <span class="gp-resa-label">Number of guests</span>
                    <div class="gp-resa-guests">
                        <button type="button" class="btn btn-light btn-lg" t-on-click="() => this.changeGuests(-1)"
                                aria-label="Fewer guests"><i class="fa fa-minus"/></button>
                        <input class="form-control form-control-lg" type="number" min="1" inputmode="numeric"
                               t-model.number="state.guests"/>
                        <button type="button" class="btn btn-light btn-lg" t-on-click="() => this.changeGuests(1)"
                                aria-label="More guests"><i class="fa fa-plus"/></button>
                    </div>
                    <span t-if="tooManyGuests" class="gp-resa-warning">
                        <i class="fa fa-exclamation-triangle"/> <t t-esc="seatsWarning"/>
                    </span>
                </div>
            </div>
            <div class="footer footer-flex modal-footer">
                <div class="button confirm highlight btn btn-lg btn-primary"
                     t-att-class="{'disabled': !isValid}" t-on-click="confirm">
                    <t t-esc="props.confirmText"/>
                </div>
                <div t-if="props.canRemove" class="button gp-resa-remove btn btn-lg btn-outline-danger" t-on-click="remove">
                    Cancel the reservation
                </div>
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </div>
            </div>
        </div>
    </t>

</templates>
